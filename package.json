{
  "name": "drawdb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names server,client --prefix-colors blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "check:server": "for f in server/*.js server/routes/*.js; do node --check \"$f\" || exit 1; done",
    "test:server": "node --test server/server.test.js server/features.test.js",
    "test:git": "node --test server/git.test.js",
    "test:import": "node --test src/utils/importSQL/normalize.test.js",
    "build": "vite build && node scripts/third-party-licenses.mjs && node scripts/precompress.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:export": "node --import ./scripts/test-loader.mjs --test src/utils/exportSQL/exportSQL.test.js src/utils/exportSQL/migration.test.js src/utils/exportAs/protobuf.test.js",
    "test:engines": "node --import ./scripts/test-loader.mjs scripts/sql-engines/run.js",
    "test:migrations": "node --import ./scripts/test-loader.mjs scripts/sql-engines/migrate.js",
    "test": "npm run test:server && npm run test:git && npm run test:import && npm run test:export",
    "licenses": "node scripts/third-party-licenses.mjs"
  },
  "dependencies": {
    "@dbml/core": "^3.13.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@douyinfe/semi-ui": "^2.77.1",
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@lexical/react": "^0.12.5",
    "@monaco-editor/react": "^4.7.0",
    "axios": "^1.16.0",
    "better-sqlite3": "^12.11.1",
    "bootstrap-icons": "^1.11.3",
    "dexie": "^3.2.4",
    "dexie-react-hooks": "^1.1.7",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^10.18.0",
    "html-to-image": "1.11.11",
    "i18next": "^23.11.4",
    "i18next-browser-languagedetector": "^8.0.0",
    "jsonschema": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lexical": "^0.12.5",
    "lodash": "^4.18.1",
    "luxon": "^3.7.1",
    "monaco-editor": "^0.52.2",
    "nanoid": "^5.1.5",
    "node-sql-parser": "^5.4.0",
    "oracle-sql-parser": "^0.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^4.4.1",
    "react-i18next": "^14.1.1",
    "react-router-dom": "^7.18.4",
    "usehooks-ts": "^3.1.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.14",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.4",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.14",
    "prettier": "3.2.5",
    "tailwindcss": "^4.0.14",
    "vite": "^8.1.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
