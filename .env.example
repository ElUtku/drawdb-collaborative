# OPCIONAL. Copia este archivo a .env solo si necesitas cambiar algo.
# Sin .env la aplicación arranca igual con los valores por defecto.

# Solo si usas "Sincronizar con Git": clave para cifrar los tokens de acceso guardados.
# Sin ella se genera una clave y se guarda en la propia base de datos.
# Genera una con: openssl rand -hex 32
GIT_SECRET_KEY=

# Pon 1 si hay un proxy inverso (Caddy, nginx, Traefik) delante. Por defecto: false.
TRUST_PROXY=false

# Orígenes extra permitidos para el WebSocket, separados por comas. Normalmente vacío.
ALLOWED_ORIGINS=
