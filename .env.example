# OPCIONAL. Copia este archivo a .env solo si necesitas cambiar algo.
# Sin .env la aplicación arranca igual con los valores por defecto.

# Código para crear la primera cuenta (la de administrador). Si lo dejas vacío,
# el servidor genera uno al arrancar sin cuentas y lo escribe en su registro:
#   podman logs drawdb-collaborative
# Mínimo 8 caracteres. Deja de usarse en cuanto existe el administrador.
SETUP_CODE=

# true para que cualquiera con acceso a la URL pueda crearse una cuenta (usuario normal).
# Por defecto: false (solo el administrador crea cuentas).
OPEN_REGISTRATION=false

# Pon 1 si hay un proxy inverso (Caddy, nginx, Traefik) delante. Por defecto: false.
TRUST_PROXY=false

# Orígenes extra permitidos para el WebSocket, separados por comas. Normalmente vacío.
ALLOWED_ORIGINS=

# Sincronización de diagramas con repositorios Git ("Archivo → Sync with git").
# false la desactiva por completo.
GIT_SYNC_ENABLED=true

# Servidores Git a los que se permite conectar, separados por comas
# (admite *.dominio). Vacío = cualquiera. Recomendado: tu servidor Git interno,
# para que nadie pueda usar la sincronización para sondear otros equipos de la red.
GIT_ALLOWED_HOSTS=

# Solo si usas la sincronización con Git: clave para cifrar los tokens de acceso guardados.
# Sin ella se genera una clave y se guarda en la propia base de datos.
# Genera una con: openssl rand -hex 32
GIT_SECRET_KEY=
